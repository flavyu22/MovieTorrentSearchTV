# The whole IDE project directory is machine-specific. Committing any of it (the
# per-developer run configurations, the Gradle sync state, the deployment-target
# selector) produces a permanently dirty working tree and leaks local SDK paths.
.idea/
*.iml
.gradle/
**/build/
/local.properties
local.properties
keystore.properties
secrets.properties
.env
.env.*
*.jks
*.keystore
*.p12
*.pem
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/captures/
.externalNativeBuild/
.cxx/

# Auto-generated by `updateDaemonJvm` from the local IDE JVM; machine-specific and
# not part of the reproducible JDK 17 toolchain, so it must not be committed.
gradle/gradle-daemon-jvm.properties

# CPython bytecode caches produced by running the scripts/ helpers locally.
__pycache__/
*.pyc
